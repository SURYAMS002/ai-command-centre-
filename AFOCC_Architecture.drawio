        <mxCell id="2" value="&lt;b&gt;Layer 1: Farmer Dashboard (Streamlit UI)&lt;/b&gt;&lt;br/&gt;&lt;font size='2'&gt;Natural Language Chat Console, Live Weather Cards, Telemetry Display&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E5631;strokeColor=#000000;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1">
